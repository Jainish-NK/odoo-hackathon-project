NODE_ENV=test
PORT=4001
API_PREFIX=/api/v1
CORS_ORIGIN=*

DATABASE_URL=postgresql://globetrotter:globetrotter@localhost:5432/globetrotter_test?schema=public

REDIS_URL=redis://localhost:6379/1

JWT_ACCESS_SECRET=test-access-secret-please-change-me
JWT_REFRESH_SECRET=test-refresh-secret-please-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

BCRYPT_SALT_ROUNDS=4

LOG_LEVEL=silent
