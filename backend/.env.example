# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# ── PostgreSQL ───────────────────────────────────────────────
# Local (outside Docker) example:
# DATABASE_URL=postgresql://globetrotter:globetrotter@localhost:5432/globetrotter?schema=public
# Inside docker-compose, the host is the service name "postgres":
DATABASE_URL=postgresql://globetrotter:globetrotter@localhost:5432/globetrotter?schema=public

POSTGRES_USER=globetrotter
POSTGRES_PASSWORD=globetrotter
POSTGRES_DB=globetrotter
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Password reset ───────────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Bcrypt ───────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
